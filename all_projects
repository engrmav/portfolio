<script>
(function(){
  // Any link back to the homepage (header nav, logo, footer nav, the
  // Back button) should land directly on its target section without the
  // homepage replaying its loading screen — that should only ever happen
  // on a true initial load or a full refresh of index.html itself. So
  // flag the trip right before the browser navigates; index.html reads
  // and consumes this flag on arrival.
  document.addEventListener('click', function(e){
    var link = e.target.closest ? e.target.closest('a[href^="index.html"]') : null;
    if(!link) return;
    try{ sessionStorage.setItem('mtv_skipLoader','1'); }catch(err){}
  });
})();
</script>
<script>
(function(){
  var overlay = document.getElementById('page-transition');
  window.addEventListener('load', function(){
    requestAnimationFrame(function(){ overlay.classList.add('hide'); });
  });

  // ---- Back button: fade the overlay in, then navigate to the homepage's
  // Selected Projects section (mirrors the wipe used to arrive here) ----
  var backBtn = document.getElementById('backToProjects');
  if(backBtn){
    backBtn.addEventListener('click', function(e){
      if(backBtn.target === '_blank' || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      overlay.classList.remove('hide');
      setTimeout(function(){ window.location.href = backBtn.getAttribute('href'); }, 480);
    });
  }

  // ---- Footer "back to top" ----
  var toTopBtn = document.getElementById('footerToTop');
  if(toTopBtn){
    toTopBtn.addEventListener('click', function(){
      if(window.__smoothScrollTo){ window.__smoothScrollTo(0); }
      else{ window.scrollTo({top:0, behavior:'smooth'}); }
    });
  }

  // ---- Light / dark mode toggle ----
  (function initThemeToggle(){
    var btn = document.getElementById('themeToggle');
    if(!btn) return;
    var root = document.documentElement;
    btn.addEventListener('click', function(){
      var isLight = root.getAttribute('data-theme') === 'light';
      if(isLight){
        root.removeAttribute('data-theme');
        try{ localStorage.setItem('mtv-theme','dark'); }catch(e){}
      } else {
        root.setAttribute('data-theme','light');
        try{ localStorage.setItem('mtv-theme','light'); }catch(e){}
      }
    });
  })();

  // ---- Global smooth scroll ----
  // Same eased wheel/touch/keyboard scrolling technique used on the
  // homepage, so this page feels continuous with the rest of the site.
  (function initGlobalSmoothScroll(){
    var docEl = document.documentElement;
    var smoothTarget = window.scrollY || docEl.scrollTop;
    var smoothCurrent = smoothTarget;
    var lastAppliedY = Math.round(smoothTarget);

    var smoothEase = 0.040;
    var wheelMultiplier = 1;
    var touchMultiplier = 1.6;

    function maxScrollY(){
      return Math.max(0, docEl.scrollHeight - window.innerHeight);
    }
    function clampTarget(){
      smoothTarget = Math.min(Math.max(smoothTarget, 0), maxScrollY());
    }

    window.__smoothScrollTo = function(y){
      smoothTarget = y;
      clampTarget();
    };
    window.__smoothScrollToEl = function(id){
      var el = document.getElementById(id);
      if(!el) return;
      window.__smoothScrollTo(el.getBoundingClientRect().top + (window.scrollY || docEl.scrollTop));
    };

    function normalizeWheelDelta(e){
      var d = e.deltaY;
      if(e.deltaMode === 1) d *= 18;
      else if(e.deltaMode === 2) d *= window.innerHeight;
      return d;
    }

    window.addEventListener('wheel', function(e){
      if(e.ctrlKey) return;
      e.preventDefault();
      smoothTarget += normalizeWheelDelta(e) * wheelMultiplier;
      clampTarget();
    }, {passive:false});

    var touchStartY = null;
    window.addEventListener('touchstart', function(e){
      if(e.touches.length !== 1) return;
      touchStartY = e.touches[0].clientY;
    }, {passive:true});
    window.addEventListener('touchmove', function(e){
      if(touchStartY === null || e.touches.length !== 1) return;
      var y = e.touches[0].clientY;
      var delta = touchStartY - y;
      touchStartY = y;
      e.preventDefault();
      smoothTarget += delta * touchMultiplier;
      clampTarget();
    }, {passive:false});
    window.addEventListener('touchend', function(){ touchStartY = null; });

    function keyStep(key){
      var page = window.innerHeight * 0.9;
      if(key === 'ArrowDown') return 90;
      if(key === 'ArrowUp') return -90;
      if(key === 'PageDown') return page;
      if(key === 'PageUp') return -page;
      if(key === ' ') return page;
      return undefined;
    }
    window.addEventListener('keydown', function(e){
      var active = document.activeElement;
      var tag = active ? active.tagName : '';
      if(/INPUT|TEXTAREA|SELECT/.test(tag) || (active && active.isContentEditable)) return;
      if(e.key === 'Home'){ e.preventDefault(); smoothTarget = 0; clampTarget(); return; }
      if(e.key === 'End'){ e.preventDefault(); smoothTarget = maxScrollY(); clampTarget(); return; }
      var step = keyStep(e.key);
      if(step === undefined) return;
      e.preventDefault();
      if(e.key === ' ' && e.shiftKey) step = -step;
      smoothTarget += step;
      clampTarget();
    }, {passive:false});

    window.addEventListener('scroll', function(){
      var y = window.scrollY || docEl.scrollTop;
      if(Math.abs(y - lastAppliedY) > 1.5){
        smoothTarget = y;
        smoothCurrent = y;
      }
    }, {passive:true});

    window.addEventListener('resize', clampTarget);

    function smoothScrollRenderLoop(){
      smoothCurrent += (smoothTarget - smoothCurrent) * smoothEase;
      if(Math.abs(smoothTarget - smoothCurrent) < 0.05){
        smoothCurrent = smoothTarget;
      }
      var y = Math.round(smoothCurrent);
      if(y !== lastAppliedY){
        lastAppliedY = y;
        window.scrollTo(0, y);
      }
      requestAnimationFrame(smoothScrollRenderLoop);
    }
    requestAnimationFrame(smoothScrollRenderLoop);
  })();
})();
</script>
