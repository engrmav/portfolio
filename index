<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>
(function(){
  try{
    var saved = localStorage.getItem('mtv-theme');
    var theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    if(theme === 'light'){ document.documentElement.setAttribute('data-theme','light'); }
  }catch(e){}
})();
</script>
<title>Maveric Viernes — AI Automation Specialist</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@300;400;500;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
<link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet">
<style>
  :root{
    --ink:#0c0d0e;
    --bone:#ece6d9;
    --bone-dim:#a9a297;
    --gold:#c9a227;
    --gold-dim:#8a7220;
    --line:#2a2a28;
    --ink-rgb:12,13,14;
    --bone-rgb:236,230,217;
    --gold-rgb:201,162,39;
    --ff-display:'Clash Display', sans-serif;
    --ff-body:'Clash Display', sans-serif;
    --ff-mono:'Clash Display', sans-serif;
    /* Soft, layered "elevation" shadow shared by every card on the site.
       Three stacked shadows (a tight contact shadow, a mid spread, and a
       wide/soft ambient glow) read as a subtle 3D lift without looking
       heavy — tuned separately per theme below since a shadow that reads
       as "subtle" on a light background is invisible on a dark one. */
    --card-shadow:
      0 1px 2px rgba(0,0,0,0.5),
      0 14px 30px rgba(0,0,0,0.42),
      0 34px 60px rgba(0,0,0,0.32);
    --card-shadow-hover:
      0 2px 4px rgba(0,0,0,0.55),
      0 20px 40px rgba(0,0,0,0.46),
      0 44px 76px rgba(0,0,0,0.36);
    color-scheme: dark;
  }
  html[data-theme="light"]{
    --ink:#ffffff;
    --bone:#111111;
    --bone-dim:#6e6e6e;
    --gold:#d4a017;
    --gold-dim:#a97e10;
    --line:#e2e2e2;
    --ink-rgb:255,255,255;
    --bone-rgb:17,17,17;
    --gold-rgb:212,160,23;
    --card-shadow:
      0 1px 2px rgba(17,17,17,0.05),
      0 14px 28px rgba(17,17,17,0.09),
      0 34px 60px rgba(17,17,17,0.08);
    --card-shadow-hover:
      0 2px 4px rgba(17,17,17,0.07),
      0 20px 38px rgba(17,17,17,0.11),
      0 44px 76px rgba(17,17,17,0.1);
    color-scheme: light;
  }
  /* The Hero section is intentionally excluded from Light Mode — it keeps
     the exact same look it has in Dark Mode. Re-pinning the shared color
     variables back to their dark-mode values on #hero-wrap means every
     hero element that reads var(--ink)/var(--bone)/var(--gold) via the
     cascade stays unchanged, even while the rest of the page switches to
     the light palette above. */
  html[data-theme="light"] #hero-wrap{
    --ink:#0c0d0e;
    --bone:#ece6d9;
    --bone-dim:#a9a297;
    --gold:#c9a227;
    --gold-dim:#8a7220;
    --line:#2a2a28;
    --ink-rgb:12,13,14;
    --bone-rgb:236,230,217;
    --gold-rgb:201,162,39;
  }
  html[data-theme="light"] ::selection{
    color:#111111;
  }
  /* Tool-stack cards use a hardcoded dark gradient in the markup above;
     give them a light equivalent so they read as white/gray cards instead
     of staying dark against the new white page background. */
  html[data-theme="light"] .tool-card{
    background:linear-gradient(165deg, #fafafa, #f0f0f0 55%);
    box-shadow:0 6px 14px rgba(17,17,17,0.08);
  }
  html[data-theme="light"] .tool-card:hover{
    background:linear-gradient(165deg, #f5efd9, #efe6c8 55%);
  }
  /* Services cards use a permanent gold-tinted border in Dark Mode to
     read as "framed" against the dark background; in Light Mode that
     same border reads as an unwanted yellow outline against the white
     card, so it's dropped here and the card leans on the (now stronger)
     shadow for definition instead. The gold border on :hover is kept —
     that's the same interactive accent every other card uses. */
  html[data-theme="light"] .service-card{
    border-color:var(--line);
  }
  html[data-theme="light"] .service-card:hover{
    border-color:var(--gold);
  }
  html{transition:background-color 0.4s ease;}
  body{transition:background-color 0.4s ease, color 0.4s ease;}
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:auto;}
  body{
    background:var(--ink);
    color:var(--bone);
    font-family:var(--ff-body);
    overflow-x:hidden;
  }
  body.loading{overflow:hidden;height:100vh;}
  ::selection{background:var(--gold);color:var(--ink);}

  /* ---------- LOADER ---------- */
  #loader{
    position:fixed;inset:0;
    background:var(--ink);
    z-index:999;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    transition:opacity 0.9s cubic-bezier(.65,0,.35,1), visibility 0.9s;
  }
  #loader.hide{opacity:0;visibility:hidden;pointer-events:none;}
  /* When arriving here via header/logo navigation from another page (or
     an in-page section link), the loading screen must not replay — only
     a true initial load / full refresh should show it. html.mtv-skip-loader
     is added by an inline script (right below) before the loader below
     ever paints, so it's skipped instantly with no flash and no change to
     the animation itself. */
  html.mtv-skip-loader #loader{display:none;}
  #loader::before{
    content:'';
    position:absolute;inset:0;
    background-image:
      repeating-linear-gradient(0deg, rgba(255,255,255,0.035) 0px, rgba(255,255,255,0.035) 1px, transparent 1px, transparent 3px);
    pointer-events:none;
    opacity:0.5;
  }
  .reel{
    position:relative;
    width:min(70vw,380px);
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:1.5rem;
  }
  .monogram{
    font-family:var(--ff-display);
    font-size:clamp(2.6rem, 8vw, 4.2rem);
    letter-spacing:0.06em;
    color:var(--bone);
    display:flex;
    gap:0.12em;
    z-index:2;
    line-height:1;
  }
  .monogram span{
    display:inline-block;
    opacity:0;
    transform:translateY(14px);
    animation:letterIn 0.6s cubic-bezier(.2,.8,.2,1) forwards;
  }
  .monogram span:nth-child(1){animation-delay:0.1s;}
  .monogram span:nth-child(2){animation-delay:0.22s;}
  .monogram span:nth-child(3){animation-delay:0.34s;}
  @keyframes letterIn{to{opacity:1;transform:translateY(0);}}

  .load-bar-row{
    display:flex;
    align-items:center;
    gap:1rem;
    width:100%;
  }
  .load-bar-track{
    flex:1;
    height:2px;
    background:var(--line);
    position:relative;
    overflow:hidden;
  }
  .load-bar-fill{
    position:absolute;
    top:0;left:0;bottom:0;
    width:0%;
    background:var(--gold);
    transition:width 0.05s linear;
  }
  .pct{
    font-family:var(--ff-mono);
    font-size:0.8rem;
    letter-spacing:0.15em;
    color:var(--bone-dim);
    z-index:2;
    white-space:nowrap;
    flex-shrink:0;
  }
  .pct b{color:var(--gold);font-weight:400;}

  .welcome-wrap{
    position:absolute;
    display:flex;
    flex-direction:column;
    align-items:center;
    opacity:0;
    transform:scale(0.96);
    pointer-events:none;
  }
  .welcome-wrap.show{
    animation:welcomeIn 1.1s cubic-bezier(.2,.8,.2,1) forwards;
  }
  @keyframes welcomeIn{
    0%{opacity:0;transform:scale(0.96);}
    60%{opacity:1;transform:scale(1.01);}
    100%{opacity:1;transform:scale(1);}
  }
  .welcome-wrap h1{
    font-family:var(--ff-display);
    font-size:clamp(2.4rem, 9vw, 5rem);
    letter-spacing:0.02em;
    color:var(--bone);
  }
  .welcome-wrap p{
    margin-top:0.6rem;
    font-family:var(--ff-mono);
    font-size:0.72rem;
    letter-spacing:0.4em;
    color:var(--gold);
    text-transform:uppercase;
  }
  .reel.fade-out{
    animation:reelOut 0.6s ease forwards;
  }
  @keyframes reelOut{to{opacity:0;transform:scale(0.9);}}

  /* ---------- PAGE TRANSITION (index -> project detail) ----------
     A simple ink-colored overlay that wipes in before we navigate to
     projects.html, and wipes back out on arrival there, so moving into
     a project reads as going deeper into the same site rather than a
     hard page load. ---------- */
  #page-transition{
    position:fixed;inset:0;
    z-index:998;
    background:var(--ink);
    opacity:0;
    pointer-events:none;
    transition:opacity 0.5s cubic-bezier(.65,0,.35,1);
  }
  #page-transition.active{
    opacity:1;
    pointer-events:auto;
  }
  @media (prefers-reduced-motion:reduce){
    #page-transition{transition:none;}
  }

  /* ---------- SCROLL PROGRESS ---------- */
  #scroll-progress{
    position:fixed;
    top:0;left:0;right:0;
    height:3px;
    z-index:60;
    background:transparent;
    pointer-events:none;
  }
  #scroll-progress-bar{
    height:100%;
    width:0%;
    background:var(--gold);
    transform-origin:left center;
    transition:width 0.08s linear;
  }

  /* ---------- NAV ---------- */
  #nav{
    position:fixed;
    top:0;left:0;right:0;
    z-index:50;
    background:rgba(var(--ink-rgb),0.55);
    -webkit-backdrop-filter:blur(14px) saturate(140%);
    backdrop-filter:blur(14px) saturate(140%);
    border-bottom:1px solid rgba(var(--bone-rgb),0.08);
    opacity:0;
    transform:translateY(-8px);
    pointer-events:none;
    transition:opacity 0.7s cubic-bezier(.2,.8,.2,1), transform 0.7s cubic-bezier(.2,.8,.2,1);
  }
  #nav.nav-visible{
    opacity:1;
    transform:translateY(0);
    pointer-events:auto;
  }
  .nav-inner{
    max-width:80rem;
    margin:0 auto;
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center;
    padding:0.80rem clamp(1.2rem,4vw,3rem);
  }
  .nav-logo{
    grid-column:1;
    justify-self:start;
    font-family:var(--ff-display);
    font-weight:700;
    font-size:1.3rem;
    letter-spacing:0.1em;
    color:var(--gold);
    text-decoration:none;
  }
  .nav-links{
    grid-column:2;
    display:flex;
    align-items:center;
    gap:clamp(1.3rem,2.6vw,2.2rem);
    font-family:var(--ff-body);
    font-weight:500;
    font-size:0.68rem;
    letter-spacing:0.16em;
  }
  .nav-links a{
    color:var(--bone);
    text-decoration:none;
    opacity:0.8;
    text-transform:uppercase;
    transition:opacity 0.25s;
  }
  .nav-links a:hover{opacity:1;}

  .nav-right{
    grid-column:3;
    justify-self:end;
    display:flex;
    align-items:center;
    gap:0.9rem;
  }
  .theme-toggle{
    display:flex;
    align-items:center;
    justify-content:center;
    width:34px;
    height:34px;
    border-radius:50%;
    border:1px solid var(--line);
    background:transparent;
    color:var(--bone);
    cursor:pointer;
    transition:border-color 0.25s, transform 0.25s, background 0.25s;
    flex-shrink:0;
  }
  .theme-toggle:hover{
    border-color:var(--gold-dim);
    transform:rotate(12deg);
  }
  .theme-toggle svg{
    width:16px;
    height:16px;
    stroke:currentColor;
  }
  .theme-toggle .icon-moon{display:none;}
  html[data-theme="light"] .theme-toggle .icon-sun{display:none;}
  html[data-theme="light"] .theme-toggle .icon-moon{display:block;}

  .nav-cta{
    display:inline-flex;
    align-items:center;
    gap:0.45rem;
    font-family:"Clash Display", var(--ff-display), sans-serif;
    font-size:0.78rem;
    font-weight:700;
    letter-spacing:0.02em;
    color:#111111;
    background:var(--gold);
    border:1px solid var(--gold);
    border-radius:999px;
    padding:0.55rem 1.1rem;
    text-decoration:none;
    white-space:nowrap;
    cursor:pointer;
    box-shadow:0 0 14px rgba(var(--gold-rgb),0.4), 0 0 3px rgba(var(--gold-rgb),0.25);
    transition:background 0.25s, filter 0.25s, transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  }
  .nav-cta svg{width:15px;height:15px;flex-shrink:0;}
  .nav-cta:hover{
    filter:brightness(1.06) saturate(1.15);
    box-shadow:0 0 4px rgba(var(--gold-rgb),0.15);
    transform:translateY(-1px);
  }
  .nav-cta-ghost{
    background:transparent;
    color:var(--bone);
    border:1px solid var(--line);
    box-shadow:none;
  }
  .nav-cta-ghost:hover{
    background:transparent;
    filter:none;
    border-color:var(--gold);
    color:var(--gold);
    transform:translateY(-1px);
  }
  @media (max-width:560px){
    .nav-cta-ghost span{display:none;}
    .nav-cta-ghost{padding:0.55rem;}
  }

  /* ---------- HERO / SCRUB VIDEO ---------- */
  #hero-wrap{
    position:relative;
    height:340vh;
    background:var(--ink);
  }
  #hero-sticky{
    position:sticky;
    top:0;
    height:100vh;
    width:100%;
    overflow:hidden;
    display:flex;
    align-items:flex-end;
  }
  #heroVideo{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    filter:saturate(0.92) contrast(1.05);
  }
  .hero-scrim{
    position:absolute;inset:0;
    background:linear-gradient(180deg, rgba(var(--ink-rgb),0.15) 0%, rgba(var(--ink-rgb),0) 32%, rgba(var(--ink-rgb),0) 60%, rgba(var(--ink-rgb),0.75) 100%);
    pointer-events:none;
  }
  .hero-content{
    position:relative;
    z-index:2;
    width:100%;
    padding:0 clamp(1.2rem,4vw,3rem) clamp(3.2rem,7vw,5.5rem);
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:1.5rem;
  }
  .hero-left{
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    max-width:min(90%, 620px);
  }
  .hero-eyebrow{
    font-family:var(--ff-mono);
    font-size:0.75rem;
    letter-spacing:0.35em;
    color:var(--gold);
    font-weight:700;
    margin-bottom:1rem;
    text-transform:uppercase;
    display:flex;
    align-items:center;
    gap:0.55em;
  }
  .hero-eyebrow::before{
    content:'';
    display:inline-block;
    width:6px;
    height:6px;
    border-radius:50%;
    background:var(--gold);
    flex-shrink:0;
  }
  .hero-title{
    font-family:var(--ff-display);
    line-height:0.92;
    letter-spacing:0.01em;
    color:var(--bone);
    margin:0;
  }
  .hero-title .first{
    display:block;
    font-size:clamp(3.2rem, 10vw, 7.5rem);
    color:var(--bone);
    font-weight:400;
  }
  .hero-title .last{
    display:block;
    font-size:clamp(3rem, 9.6vw, 7.2rem);
    color:transparent;
    -webkit-text-stroke:2px var(--bone);
    text-stroke:2px var(--bone);
    letter-spacing:0.01em;
    margin-top:0.05em;
  }
  .hero-tagline{
    margin-top:1.4rem;
    max-width:34ch;
    font-family:var(--ff-body);
    font-weight:300;
    font-size:clamp(0.95rem, 1.6vw, 1.15rem);
    line-height:1.6;
    color:var(--bone);
  }
  .hero-cta-row{
    margin-top:1.6rem;
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:0.9rem;
  }
  .cta-btn{
    position:relative;
    overflow:hidden;
    display:inline-flex;
    align-items:center;
    gap:0.6rem;
    padding:0.85rem 1.8rem;
    background:var(--gold);
    color:var(--ink);
    border:1px solid var(--gold);
    border-radius:999px;
    font-family:var(--ff-mono);
    font-size:0.78rem;
    letter-spacing:0.15em;
    text-transform:uppercase;
    font-weight:700;
    text-decoration:none;
    cursor:pointer;
    box-shadow:0 0 18px rgba(var(--gold-rgb),0.4), 0 0 4px rgba(var(--gold-rgb),0.25);
    transition:background 0.25s, filter 0.25s, transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  }
  .cta-btn svg{
    width:15px;
    height:15px;
    flex-shrink:0;
    position:relative;
    z-index:2;
  }
  .cta-btn span{position:relative;z-index:2;}
  .cta-btn:hover{
    filter:brightness(1.06) saturate(1.15);
    box-shadow:0 0 5px rgba(var(--gold-rgb),0.18);
    transform:translateY(-2px);
  }
  .cta-btn-ghost{
    background:transparent;
    color:var(--bone);
    border:1px solid var(--line);
    box-shadow:none;
  }
  .cta-btn-ghost:hover{
    background:transparent;
    filter:none;
    border-color:var(--gold);
    color:var(--gold);
  }
  /* Glossy sheen — a soft diagonal highlight periodically sweeps across
     the primary "Let's Connect" button, like light catching a polished
     surface, as a gentle cue that it's interactive. It idles most of the
     cycle and only briefly sweeps, so it reads as elegant rather than
     distracting. It pauses on hover (the button turns solid instead) and
     the ghost "Download CV" button is excluded entirely. */
  .cta-btn:not(.cta-btn-ghost)::after{
    content:'';
    position:absolute;
    top:0;bottom:0;
    left:-60%;
    width:35%;
    background:linear-gradient(115deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.45) 50%, rgba(255,255,255,0) 100%);
    transform:skewX(-20deg);
    pointer-events:none;
    z-index:1;
    animation:ctaSheenAuto 4.2s ease-in-out infinite;
    transition:opacity 0.25s ease;
  }
  .cta-btn:not(.cta-btn-ghost):hover::after{
    opacity:0;
    animation-play-state:paused;
  }
  @keyframes ctaSheenAuto{
    0%{left:-60%;}
    55%{left:-60%;}
    75%{left:130%;}
    100%{left:130%;}
  }
  @media (prefers-reduced-motion:reduce){
    .cta-btn:not(.cta-btn-ghost)::after{animation:none;}
  }
  .scroll-cue{
    display:flex;
    align-items:center;
    justify-content:center;
    animation:scrollArrowBob 1.6s ease-in-out infinite;
    will-change:transform;
  }
  .scroll-cue svg{
    display:block;
    width:22px;
    height:56px;
  }
  @keyframes scrollArrowBob{
    0%,100%{transform:translateY(0);opacity:1;}
    50%{transform:translateY(14px);opacity:0.45;}
  }

  /* ---------- MARQUEE SECTION (separate section, AFTER video scroll effect) ---------- */
  .marquee-section{
    position:relative;
    z-index:3;
    background:var(--ink);
    padding:0 0 clamp(0.8rem,2vw,1.5rem);
    overflow:hidden;
    opacity:1;
    transform:none;
  }
  .skills-marquee{
    width:100%;
    overflow:hidden;
    border-top:1px solid var(--bone);
    border-bottom:1px solid var(--bone);
    padding:3.2rem 0;
  }
  .skills-track{
    display:flex;
    align-items:center;
    width:max-content;
    /* MARQUEE SPEED — lower seconds = faster scroll. Was 14s. */
    animation:skillsMarquee 18s linear infinite;
  }
  .skills-track .mq-set{
    display:flex;
    align-items:center;
    flex-shrink:0;
  }
  .skills-track .mq-item,
  .skills-track .mq-dot{
    flex-shrink:0;
    white-space:nowrap;
    font-family:"Clash Display", var(--ff-display), sans-serif;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:0.02em;
    line-height:1;
    /* MARQUEE FONT SIZE — was clamp(3.5rem, 4vw, 8rem). */
    font-size:clamp(3.1rem, 3.6vw, 7.2rem);
  }
  .skills-track .mq-item{
    color:transparent;
    -webkit-text-stroke:1.5px var(--bone);
    text-stroke:1.5px var(--bone);
  }
  .skills-track .mq-dot{
    margin:0 4rem;
    font-size:2em;
    color:var(--bone-dim);
  }
  @keyframes skillsMarquee{
    from{transform:translateX(0);}
    to{transform:translateX(-50%);}
  }
  @media (prefers-reduced-motion:reduce){
    .scroll-cue{animation:none;}
  }

  /* ---------- KARAOKE TEXT — flows normally with scroll (no pinning);
     words reveal left to right as the sentence passes through the
     viewport, exactly like any other content scrolling by ---------- */
  .karaoke-section{
    min-height:60vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:2vh clamp(1.2rem,4vw,3rem);
    margin-top:10vh;
  }
  .karaoke-text{
    max-width:1280px;
    text-align:center;
    font-family:"Clash Display", sans-serif;
    font-weight:400;
    font-size:clamp(1.7rem, 4.4vw, 3.6rem);
    line-height:1.3;
    letter-spacing:0.01em;
  }
  .kw{
    position:relative;
    display:inline-block;
    color:var(--bone);
    opacity:0.35;
    font-weight:900;
    -webkit-text-stroke:0.6px currentColor;
    text-stroke:0.6px currentColor;
    filter:blur(2.2px);
    transform:translateY(0.3em) scale(0.99);
    text-shadow:0 0 0 rgba(var(--gold-rgb),0);
