<script>
(function(){
  var body = document.body;
  var pctNum = document.getElementById('pctNum');
  var barFill = document.getElementById('loadBarFill');
  var reel = document.getElementById('reel');
  var welcome = document.getElementById('welcomeWrap');
  var loader = document.getElementById('loader');

  var pct = 0;
  var duration = 2400; // ms for 1 -> 100
  var start = null;

  function frame(ts){
    if(!start) start = ts;
    var elapsed = ts - start;
    var t = Math.min(elapsed / duration, 1);
    pct = Math.round(t * 100);
    pctNum.textContent = String(pct).padStart(2,'0');
    barFill.style.width = (t * 100) + '%';
    if(t < 1){
      requestAnimationFrame(frame);
    } else {
      finishLoad();
    }
  }

  function finishLoad(){
    reel.classList.add('fade-out');
    setTimeout(function(){
      welcome.classList.add('show');
    }, 250);
    setTimeout(function(){
      loader.classList.add('hide');
      body.classList.remove('loading');
    }, 1500);
  }

  // html.mtv-skip-loader means the inline script at the top of <body>
  // already hid the loader and unlocked scrolling before this ever ran —
  // this is in-site navigation (header nav / logo / a section link from
  // another page), not an initial load or a full refresh. So skip the
  // reel/percentage animation entirely and, once the rest of this script
  // has finished running (so window.__smoothScrollToEl exists), ease
  // straight to whichever section was requested using the site's normal
  // smooth-scroll behavior. A true initial load or full refresh never has
  // this class, so it plays the loader exactly as before.
  if(document.documentElement.classList.contains('mtv-skip-loader')){
    loader.classList.add('hide');
    welcome.classList.add('show');
    var skipTargetId = location.hash ? location.hash.slice(1) : '';
    window.addEventListener('load', function(){
      if(skipTargetId && window.__smoothScrollToEl){
        window.__smoothScrollToEl(skipTargetId);
      } else if(skipTargetId){
        var targetEl = document.getElementById(skipTargetId);
        if(targetEl) targetEl.scrollIntoView();
      }
    });
  } else {
    requestAnimationFrame(frame);
  }

  // ---- Scroll progress indicator ----
  var progressBar = document.getElementById('scroll-progress-bar');
  function updateScrollProgress(){
    var scrollTop = window.scrollY || document.documentElement.scrollTop;
    var docHeight = document.documentElement.scrollHeight - window.innerHeight;
    var pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    progressBar.style.width = Math.min(Math.max(pct, 0), 100) + '%';
  }
  window.addEventListener('scroll', function(){
    requestAnimationFrame(updateScrollProgress);
    requestAnimationFrame(updateNavVisibility);
  }, {passive:true});
  window.addEventListener('resize', function(){
    updateScrollProgress();
    updateNavVisibility();
  });
  updateScrollProgress();

  // ---- Karaoke-style scroll-reveal text — NOT pinned. The section scrolls
  // past normally like any other content; progress is read from the
  // sentence's own position as it travels up through the viewport, then
  // eased over time (not just over scroll pixels) so the reveal keeps
  // flowing smoothly instead of snapping to each scroll event. ----
  var karaokeSection = document.getElementById('karaokeSection');
  var karaokeText = document.getElementById('karaokeText');
  var karaokeWords = [];
  var karaokeCurrent = []; // each word's own smoothed (displayed) progress, 0–1

  (function buildKaraokeWords(){
    if(!karaokeText) return;
    var phrase = "I blend technical expertise with problem-solving to build workflow automation solutions that streamline processes, reduce manual work, and drive business efficiency.";
    var parts = phrase.split(' ');
    karaokeText.innerHTML = parts.map(function(word){
      var clean = word.toLowerCase().replace(/[^a-z]/g, '');
      var isHighlight = clean === 'workflow' || clean === 'automation';
      return '<span class="kw"' + (isHighlight ? ' data-highlight="1"' : '') + '>' + word + '</span>';
    }).join(' ');
    karaokeWords = Array.prototype.slice.call(karaokeText.querySelectorAll('.kw'));
    karaokeCurrent = karaokeWords.map(function(){ return 0; });
  })();

  // smoothstep — gentle ease-in AND ease-out, reads as a soft, continuous
  // dissolve with no snap on either end
  function smoothstep(t){ return t * t * (3 - 2 * t); }

  // Every word fades up from soft, faded white into a clear, bright white —
  // only "workflow automation" eases into the gold accent instead.
  // Read live from the CSS variables (rather than hardcoding) so the
  // karaoke word color follows whichever theme is active — light or dark
  // — including the moment the user toggles between them.
  function parseRgbVar(varName, fallback){
    var raw = getComputedStyle(document.documentElement).getPropertyValue(varName);
    var parts = raw.split(',').map(function(n){ return parseInt(n, 10); });
    return (parts.length === 3 && !parts.some(isNaN)) ? parts : fallback;
  }
  var kwFaded = parseRgbVar('--bone-rgb', [236, 230, 217]);  // --bone, dimmed via opacity at rest
  var kwGold = parseRgbVar('--gold-rgb', [201, 162, 39]);    // var(--gold)
  window.__refreshKaraokeTheme = function(){
    kwFaded = parseRgbVar('--bone-rgb', kwFaded);
    kwGold = parseRgbVar('--gold-rgb', kwGold);
  };

  function karaokeLoop(){
    if(karaokeText && karaokeWords.length){
      var rect = karaokeText.getBoundingClientRect();
      var vh = window.innerHeight;

      // target progress: 0 the moment the sentence's top edge crosses into
      // the viewport from the bottom, 1 once it has scrolled naturally up
      // to roughly the upper third of the screen
      var startY = vh * 0.98;
      var endY = vh * 0.32;
      var targetP = (startY - rect.top) / (startY - endY);
      targetP = Math.min(Math.max(targetP, 0), 1);

      var n = karaokeWords.length;
      // band > 1 word means each word's *target* is already offset from its
      // neighbors — the spatial half of the left-to-right wave
      var band = 3.4;
      for(var i = 0; i < n; i++){
        var localRaw = (targetP * (n - 1 + band)) - i;
        var targetWp = Math.min(Math.max(localRaw / band, 0), 1);
        var targetEased = smoothstep(targetWp);

        // the temporal half of the wave: each word's *displayed* value
        // eases toward its target over time rather than jumping straight
        // to it, and later words are given a touch more lag — so the
        // sentence keeps gently animating for a moment after the scroll
        // itself has stopped, and words visibly wake up one after another
        var damping = 0.005 + (i / n) * 0.05;
        karaokeCurrent[i] += (targetEased - karaokeCurrent[i]) * damping;
        var eased = karaokeCurrent[i];

        var word = karaokeWords[i];
        var isHighlight = word.hasAttribute('data-highlight');

        // purely monotonic per-frame values — lifts, sharpens and brightens,
        // no overshoot, no flash, nothing that snaps
        var lift = (1 - eased) * 0.3;                  // em, slow upward rise
        var blur = (1 - eased) * 2.2;                   // px, gradually comes into focus
        var scale = 0.99 + 0.01 * eased;                 // a hair of settle, no pop
        var opacity = 0.35 + 0.65 * eased;                // soft/faded → fully clear

        var r, g, b, glow;
        if(isHighlight){
          r = Math.round(kwFaded[0] + (kwGold[0] - kwFaded[0]) * eased);
          g = Math.round(kwFaded[1] + (kwGold[1] - kwFaded[1]) * eased);
          b = Math.round(kwFaded[2] + (kwGold[2] - kwFaded[2]) * eased);
          // subtle, steadily-growing glow — never a spike, just gently noticeable
          glow = eased * 0.4;
        } else {
          r = kwFaded[0]; g = kwFaded[1]; b = kwFaded[2];
          glow = 0;
        }

        word.style.opacity = opacity.toFixed(3);
        word.style.filter = 'blur(' + blur.toFixed(2) + 'px)';
        word.style.transform = 'translateY(' + lift.toFixed(3) + 'em) scale(' + scale.toFixed(3) + ')';
        word.style.color = 'rgb(' + r + ',' + g + ',' + b + ')';
        word.style.textShadow = glow > 0.03
          ? '0 0 ' + (10 * glow).toFixed(1) + 'px rgba(var(--gold-rgb),' + glow.toFixed(2) + ')'
          : 'none';
      }
    }
    requestAnimationFrame(karaokeLoop);
  }
  requestAnimationFrame(karaokeLoop);

  // ---- Marquee section reveal (fires once it naturally scrolls into view,
  // i.e. after the fullscreen video scroll effect has fully completed) ----
  var marqueeSection = document.getElementById('marqueeSection');
  var navEl = document.getElementById('nav');
  if(marqueeSection && 'IntersectionObserver' in window){
    var marqueeObserver = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          marqueeSection.classList.add('in-view');
        }
      });
    }, {threshold:0.15});
    marqueeObserver.observe(marqueeSection);
  } else if(marqueeSection){
    marqueeSection.classList.add('in-view');
  }

  // ---- Header visibility: tied purely to scroll position relative to the
  // hero video-scroll effect. It only shows once that effect is fully
  // finished, and hides again whenever the page is back at the very top —
  // so scrolling to top (e.g. clicking the MTV logo) then scrolling back
  // down always makes it wait for the effect to finish again. ----
  function updateNavVisibility(){
    if(!navEl || !heroWrap) return;
    var total = heroWrap.offsetHeight - window.innerHeight;
    var scrollTop = window.scrollY || document.documentElement.scrollTop;
    var p = total > 0 ? scrollTop / total : 1;
    if(p >= 0.995){
      navEl.classList.add('nav-visible');
    } else {
      navEl.classList.remove('nav-visible');
    }
  }

  // ---- Scroll-scrubbed hero video ----
  var video = document.getElementById('heroVideo');
  var heroWrap = document.getElementById('hero-wrap');
  video.pause();

  function scrubVideo(){
    if(!video.duration || isNaN(video.duration)) return;
    var rect = heroWrap.getBoundingClientRect();
    var total = heroWrap.offsetHeight - window.innerHeight;
    var p = -rect.top / total;
    p = Math.min(Math.max(p, 0), 1);
    var target = p * video.duration;
    if(Math.abs(video.currentTime - target) > 0.02){
      video.currentTime = target;
    }
  }

  video.addEventListener('loadedmetadata', scrubVideo);
  window.addEventListener('scroll', function(){
    requestAnimationFrame(scrubVideo);
  }, {passive:true});
  window.addEventListener('resize', scrubVideo);

  // ---- Tool Stack: pinned stacked -> scatter scroll animation ----
  // Every .tool-card starts piled on top of the others in one tight central
  // stack — heavily overlapping, only slivers of each card peeking out from
  // behind the one above it — and eases out to its natural CSS-grid position
  // as the section scrolls through, in the same pin/sticky pattern used by
  // Projects below. Scroll only drives a TARGET progress value; the value
  // actually drawn (currentP) eases toward it a little every frame, which is
  // what makes the spread read as slow and heavy instead of tracking the
  // scrollbar 1:1. Each card also owns its own slice of that progress (its
  // startP..endP window), so they peel off the stack one after another
  // instead of all moving at once.
  //
  // The section's extra scroll height is split into two parts: a SCATTER
  // range, where progress climbs 0 -> 1, and a HOLD range straight after it,
  // where progress is clamped at 1 so every card just sits still in its
  // final position while the section stays pinned — before the pin finally
  // releases and normal vertical scrolling continues.
  (function initToolstackScatter(){
    var stageWrap = document.getElementById('toolstackStageWrap');
    var grid = document.getElementById('toolstackGrid');
    if(!stageWrap || !grid) return;
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.tool-card'));
    if(!cards.length) return;

    var targetP = 0;
    var currentP = 0;
    var ease = 0.022; // small = slow, heavy, deliberate catch-up per frame
    var meta = []; // per-card {dx, dy, rot, startP, endP}
    var scatterPx = 0; // scroll pixels devoted to 0 -> 1 progress
    var holdPx = 0;    // scroll pixels devoted to holding at progress = 1

    // How much of the section's total scroll room is spent actually
    // scattering vs. holding still once fully scattered. Bigger multipliers
    // = more scroll input needed = a slower-feeling drag across the deck.
    var scatterMultiplier = 3.2; // × viewport height — long scroll room, deliberate pace
    var holdMultiplier = 0.5;    // × viewport height

    // Deterministic per-card "randomness" so the pile looks natural but
    // never reshuffles between frames/resizes.
    function seeded(n){
      var x = Math.sin(n * 12.9898) * 43758.5453;
      return x - Math.floor(x);
    }

    function computeMeta(){
      var centerX = grid.clientWidth / 2;
      var centerY = grid.clientHeight / 2;
      var count = cards.length;
      var duration = 0.62; // each card animates over 62% of the scatter range
      var step = count > 1 ? (1 - duration) / (count - 1) : 0;
      meta = cards.map(function(card, i){
        var cx = card.offsetLeft + card.offsetWidth / 2;
        var cy = card.offsetTop + card.offsetHeight / 2;
        var r1 = seeded(i + 1.11);
        var r2 = seeded(i + 7.31);
        var r3 = seeded(i + 19.7);
        // First card in the deck sits on top of the pile (highest z-index)
        // and is the first to peel away, revealing the ones underneath as
        // it moves — deeper cards (higher i) sit further down the stack.
        card.style.zIndex = String(count - i);
        // Rest-state visibility eases off gently with depth so the WHOLE
        // pile still reads as one combined deck — every card's edge is
        // visible, layered behind the top one — rather than a single card
        // with everything else nearly invisible underneath it.
        var restOpacity = Math.max(1 - i * 0.045, 0.55);
        return {
          // Small jitter (not a full-size offset) keeps the piled state a
          // TIGHT overlapping deck — cards sit almost exactly on top of one
          // another, fanned just enough that every card's edge peeks out
          // from behind the one above it — rather than loosely scattered
          // near the center.
          dx: (centerX - cx) + (r2 * 2 - 1) * 13,
          dy: (centerY - cy) + (r3 * 2 - 1) * 13,
          rot: (r1 * 2 - 1) * 13,
          restOpacity: restOpacity,
          startP: i * step,
          endP: i * step + duration
        };
      });
    }

    function easeOutCubic(t){ return 1 - Math.pow(1 - t, 3); }

    function sizeSection(){
      scatterPx = window.innerHeight * scatterMultiplier;
      holdPx = window.innerHeight * holdMultiplier;
      stageWrap.style.height = (window.innerHeight + scatterPx + holdPx) + 'px';
    }

    function updateTarget(){
      var totalExtra = stageWrap.offsetHeight - window.innerHeight;
      if(totalExtra <= 0 || scatterPx <= 0){ targetP = 0; return; }
      var rect = stageWrap.getBoundingClientRect();
      var scrolledIn = Math.min(Math.max(-rect.top, 0), totalExtra);
      // Past the scatter range this naturally exceeds 1 and gets clamped —
      // that clamp IS the hold: progress just stays at 1 while the section
      // keeps scrolling past (still pinned) through the hold range.
      var p = scrolledIn / scatterPx;
      targetP = Math.min(Math.max(p, 0), 1);
    }

    function updateCardStyles(){
      currentP += (targetP - currentP) * ease;
      if(Math.abs(targetP - currentP) < 0.0006) currentP = targetP;
      for(var i = 0; i < cards.length; i++){
        var m = meta[i];
        var span = m.endP - m.startP;
        var local = span > 0 ? (currentP - m.startP) / span : currentP;
        local = Math.min(Math.max(local, 0), 1);
        var e = easeOutCubic(local);
        var stackAmt = 1 - e; // 1 = fully piled, 0 = fully settled in the grid
        var tx = (m.dx * stackAmt).toFixed(1);
        var ty = (m.dy * stackAmt).toFixed(1);
        var rot = (m.rot * stackAmt).toFixed(2);
        var scale = (1 - 0.05 * stackAmt).toFixed(3);
        // Fades from this card's hidden-in-the-stack opacity up to fully
        // visible as it individually settles — not a uniform site-wide fade.
        var opacity = (m.restOpacity + (1 - m.restOpacity) * e).toFixed(3);
        var card = cards[i];
        card.style.transform = 'translate(' + tx + 'px,' + ty + 'px) rotate(' + rot + 'deg) scale(' + scale + ')';
        card.style.opacity = opacity;
      }
    }

    function renderLoop(){
      updateCardStyles();
      requestAnimationFrame(renderLoop);
    }

    computeMeta();
    sizeSection();
    updateTarget();
    currentP = targetP; // settled on first paint, no glide-in on load
    // Apply the stacked/settled transforms synchronously right away — before
    // the first requestAnimationFrame tick — so if the page loads (or is
    // refreshed) without having scrolled into this section yet, the cards
    // are already rendered fully combined into one deck on the very first
    // paint, never briefly flashed in their spread-out grid positions.
    updateCardStyles();
    requestAnimationFrame(renderLoop);

    window.addEventListener('scroll', function(){
      requestAnimationFrame(updateTarget);
    }, {passive:true});
    window.addEventListener('resize', function(){
      computeMeta();
      sizeSection();
      updateTarget();
    });
    window.addEventListener('load', function(){
      computeMeta();
      sizeSection();
      updateTarget();
    });
  })();

  // ---- Projects: pinned horizontal scroll ----
  // The section's height is set (in px) to exactly the amount of extra
  // scroll room needed to pan the track from its first card to its last,
  // so the pin releases the instant the final item is fully in view and
  // the page's own scroll never feels hijacked.
  //
  // The cards' horizontal position is NOT locked 1:1 to scroll position
  // anymore. Scrolling only nudges a TARGET progress value; the position
  // that's actually drawn on screen (projectsCurrentP) eases toward that
  // target a little on every animation frame, forever — not just while a
  // scroll event is firing. That's what makes one scroll read as a slow,
  // heavy push: the cards keep gliding for a while after the scroll input
  // itself has already stopped, then gradually settle. Lower projectsEase
  // = slower, heavier, more inertia.
  var projectsSection = document.getElementById('projects');
  var projectsTrack = document.getElementById('projectsTrack');
  var projectsProgressFill = document.getElementById('projectsProgressFill');

  var projectsTargetP = 0;    // raw progress, read straight from scroll position
  var projectsCurrentP = 0;   // eased progress — the value actually rendered
  var projectsEase = 0.035;   // per-frame catch-up rate (0–1); smaller = slower glide

  // How much LONGER the section stays pinned, compared to the bare minimum
  // scroll distance the horizontal travel itself requires. This only
  // stretches the amount of scrolling it takes to go from p=0 to p=1 — it
  // does NOT change how far the track travels or where it ends up. Bigger
  // number = same horizontal journey, spread across more scroll input =
  // slower, less rushed. 1 = old behavior (scroll distance == travel distance).
  var projectsScrollStretch = 1.8;

  // The section stays pinned for a little LONGER than the track's natural
  // width requires. That extra scroll room keeps translating the track past
  // the point where the last card (View All Projects) would sit flush with
  // the screen's right edge, so it keeps drifting a bit further and comes
  // to rest pulled inward — fully visible, closer to the center of the
  // screen — before the pin finally releases and normal vertical scrolling
  // continues.
  function getProjectsEndPad(){
    return Math.min(window.innerWidth * 0.26, 320);
  }

  // The actual horizontal distance the track travels (unchanged by the
  // stretch factor) — this is what determines the cards' final resting
  // position, so it must stay exactly as it was.
  function getProjectsTravelDistance(){
    if(!projectsTrack) return 0;
    return Math.max(0, projectsTrack.scrollWidth - window.innerWidth) + getProjectsEndPad();
  }

  function sizeProjectsSection(){
    if(!projectsSection || !projectsTrack) return;
    var travel = getProjectsTravelDistance();
    var scrollDistance = travel * projectsScrollStretch;
    projectsSection.style.height = (window.innerHeight + scrollDistance) + 'px';
  }

  // Reads scroll position and updates the TARGET only. No DOM writes here —
  // that's left entirely to the render loop below, so the two are decoupled.
  // maxScrollY here is the STRETCHED (longer) distance, so p reaches 1 only
  // after the user has scrolled further than the track's travel distance —
  // that's what makes the same horizontal journey feel slower.
  function updateProjectsTarget(){
    if(!projectsSection || !projectsTrack) return;
    var maxScrollY = projectsSection.offsetHeight - window.innerHeight;
    if(maxScrollY <= 0){
      projectsTargetP = 0;
      return;
    }
    var rect = projectsSection.getBoundingClientRect();
    var p = -rect.top / maxScrollY;
    projectsTargetP = Math.min(Math.max(p, 0), 1);
  }

  // Runs continuously via requestAnimationFrame — independent of the scroll
  // event — so the slide keeps drifting and slowing down even after the
  // user has stopped scrolling, instead of freezing the instant they do.
  function projectsRenderLoop(){
    if(projectsTrack){
      projectsCurrentP += (projectsTargetP - projectsCurrentP) * projectsEase;
      // snap the last sliver so it actually comes to rest instead of
      // creeping toward the target forever
      if(Math.abs(projectsTargetP - projectsCurrentP) < 0.0004){
        projectsCurrentP = projectsTargetP;
      }
      // maxTranslate is the unstretched travel distance — p (0–1) maps onto
      // this exact same distance it always did, so the final position when
      // p=1 is pixel-identical to before. Only the scroll input needed to
      // reach p=1 got longer.
      var maxTranslate = getProjectsTravelDistance();
      projectsTrack.style.transform = 'translateX(-' + (projectsCurrentP * maxTranslate).toFixed(1) + 'px)';
      if(projectsProgressFill) projectsProgressFill.style.width = (projectsCurrentP * 100).toFixed(1) + '%';
    }
    requestAnimationFrame(projectsRenderLoop);
  }

  sizeProjectsSection();
  updateProjectsTarget();
  projectsCurrentP = projectsTargetP; // start settled, no glide on first paint
  requestAnimationFrame(projectsRenderLoop);

  window.addEventListener('scroll', function(){
    requestAnimationFrame(updateProjectsTarget);
  }, {passive:true});
  window.addEventListener('resize', function(){
    sizeProjectsSection();
    updateProjectsTarget();
  });
  // fonts loading late can change track width — resync shortly after load
  window.addEventListener('load', function(){
    sizeProjectsSection();
    updateProjectsTarget();
  });

  updateNavVisibility();

  // ---- Footer "back to top" button ----
  (function initFooterToTop(){
    var btn = document.getElementById('footerToTop');
    if(!btn) return;
    btn.addEventListener('click', function(){
      if(window.__smoothScrollTo){ window.__smoothScrollTo(0); }
      else{ window.scrollTo({top:0, behavior:'smooth'}); }
    });
  })();

  // ---- Calendly embed follows the site's light/dark theme ----
  // The Calendly inline widget only reads its colors once, from the
  // data-url query string, at the moment widget.js scans the DOM. So on
  // first load we just make sure that URL already matches whichever theme
  // is active; on a live toggle we tear down and re-embed via Calendly's
  // own API so the booking iframe re-renders in the new theme instantly.
  (function initCalendlyTheme(){
    var container = document.getElementById('calendlyEmbed');
    if(!container) return;
    function urlForCurrentTheme(){
      var isLight = document.documentElement.getAttribute('data-theme') === 'light';
      var base = 'https://calendly.com/maveviernes499/30min?hide_gdpr_banner=1';
      return isLight
        ? base + '&background_color=ffffff&text_color=111111&primary_color=d4a017'
        : base + '&background_color=0c0d0e&text_color=ece6d9&primary_color=c9a227';
    }
    container.setAttribute('data-url', urlForCurrentTheme());
    window.__refreshCalendlyTheme = function(){
      var url = urlForCurrentTheme();
      if(window.Calendly && typeof window.Calendly.initInlineWidget === 'function'){
        container.innerHTML = '';
        window.Calendly.initInlineWidget({ url: url, parentElement: container });
      } else {
        container.setAttribute('data-url', url);
      }
    };
  })();

  // ---- Light / dark mode toggle ----
  (function initThemeToggle(){
    var btn = document.getElementById('themeToggle');
    if(!btn) return;
    var root = document.documentElement;
    btn.addEventListener('click', function(){
      var isLight = root.getAttribute('data-theme') === 'light';
      if(isLight){
        root.removeAttribute('data-theme');
        try{ localStorage.setItem('mtv-theme','dark'); }catch(e){}
      } else {
        root.setAttribute('data-theme','light');
        try{ localStorage.setItem('mtv-theme','light'); }catch(e){}
      }
      // Re-sync karaoke word colors and the Calendly embed to the newly
      // active theme immediately, rather than waiting on their own logic.
      if(typeof window.__refreshKaraokeTheme === 'function'){ window.__refreshKaraokeTheme(); }
      if(typeof window.__refreshCalendlyTheme === 'function'){ window.__refreshCalendlyTheme(); }
    });
  })();

  // ---- Page transition into project detail pages ----
  // Any link headed to projects.html (a project card or "View All
  // Projects") fades the ink overlay in first, then navigates — so
  // opening a project feels like stepping deeper into the site instead
  // of a plain browser navigation.
  (function initProjectTransition(){
    var overlay = document.getElementById('page-transition');
    if(!overlay) return;
    var links = document.querySelectorAll('a[href^="projects.html"]');
    links.forEach(function(link){
      link.addEventListener('click', function(e){
        var href = link.getAttribute('href');
        if(link.target === '_blank' || e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        overlay.classList.add('active');
        setTimeout(function(){ window.location.href = href; }, 480);
      });
    });
  })();

  // ---- Global smooth scroll (Home, About, Projects, Project Detail,
  // Contact — the whole page) --------------------------------------------
  // Wheel/touch/keyboard input no longer jumps window.scrollY straight to
  // a new value. Instead it only nudges a TARGET; the value actually
  // applied via window.scrollTo eases toward that target a little on every
  // animation frame, forever — exactly the same technique already used for
  // the Projects cards above. That's what makes one scroll input read as a
  // slow, weighted push that keeps gliding after the input stops, then
  // gradually settles, instead of the browser's default instant jump.
  //
  // Deliberately built on top of the REAL window scroll position (not a
  // transformed wrapper div), so every existing effect on this page that
  // reads window.scrollY / getBoundingClientRect() — the hero video scrub,
  // the karaoke reveal, the projects pin, the nav visibility — keeps
  // working exactly as before, just fed a smoothed scroll position instead
  // of a jumpy one.
  (function initGlobalSmoothScroll(){
    var docEl = document.documentElement;
    var smoothTarget = window.scrollY || docEl.scrollTop;
    var smoothCurrent = smoothTarget;
    var lastAppliedY = Math.round(smoothTarget);

    // Smaller = slower, heavier, more inertia. Kept gentle so the page
    // still feels responsive rather than sluggish.
    var smoothEase = 0.040;
    var wheelMultiplier = 1;
    var touchMultiplier = 1.6;

    function isLoading(){
      return body.classList.contains('loading');
    }

    function maxScrollY(){
      return Math.max(0, docEl.scrollHeight - window.innerHeight);
    }

    // The hero/video section must keep responding to scroll input directly
    // and immediately, with zero added inertia — exactly as it did before
    // global smooth scrolling existed. So while the page is still within
    // the hero's own scroll range (the same range scrubVideo() uses to
    // scrub the video), this system steps aside entirely and lets the
    // browser's native, instant scroll drive it. Smoothing only takes over
    // once the user has scrolled past the hero section.
    function heroMaxScroll(){
      return heroWrap ? Math.max(0, heroWrap.offsetHeight - window.innerHeight) : 0;
    }
    function isInHeroRange(){
      var y = window.scrollY || docEl.scrollTop;
      return y < heroMaxScroll() - 0.5;
    }

    function clampTarget(){
      smoothTarget = Math.min(Math.max(smoothTarget, 0), maxScrollY());
    }

    // Anything on the page that wants to jump to a spot (nav logo, CTA
    // button, in-page anchor links) routes through here instead of the
    // browser's native smooth scroll, so there's only ever one animation
    // driving the page at a time.
    window.__smoothScrollTo = function(y){
      smoothTarget = y;
      clampTarget();
    };
    window.__smoothScrollToEl = function(id){
      var el = document.getElementById(id);
      if(!el) return;
      window.__smoothScrollTo(el.getBoundingClientRect().top + (window.scrollY || docEl.scrollTop));
    };

    function normalizeWheelDelta(e){
      var d = e.deltaY;
      if(e.deltaMode === 1) d *= 18;                 // "line" mode → approx px
      else if(e.deltaMode === 2) d *= window.innerHeight; // "page" mode
      return d;
    }

    window.addEventListener('wheel', function(e){
      if(isLoading() || e.ctrlKey) return; // leave pinch-zoom alone
      if(isInHeroRange()) return; // let the hero video scrub natively, unsmoothed
      e.preventDefault();
      smoothTarget += normalizeWheelDelta(e) * wheelMultiplier;
      clampTarget();
    }, {passive:false});

    var touchStartY = null;
    window.addEventListener('touchstart', function(e){
      if(isLoading() || e.touches.length !== 1) return;
      touchStartY = e.touches[0].clientY;
    }, {passive:true});
    window.addEventListener('touchmove', function(e){
      if(isLoading() || touchStartY === null || e.touches.length !== 1) return;
      var y = e.touches[0].clientY;
      var delta = touchStartY - y;
      touchStartY = y;
      if(isInHeroRange()) return; // let the hero video scrub natively, unsmoothed
      e.preventDefault();
      smoothTarget += delta * touchMultiplier;
      clampTarget();
    }, {passive:false});
    window.addEventListener('touchend', function(){ touchStartY = null; });

    function keyStep(key){
      var page = window.innerHeight * 0.9;
      if(key === 'ArrowDown') return 90;
      if(key === 'ArrowUp') return -90;
      if(key === 'PageDown') return page;
      if(key === 'PageUp') return -page;
      if(key === ' ') return page;
      return undefined;
    }
    window.addEventListener('keydown', function(e){
      if(isLoading()) return;
      var active = document.activeElement;
      var tag = active ? active.tagName : '';
      if(/INPUT|TEXTAREA|SELECT/.test(tag) || (active && active.isContentEditable)) return;
      if(e.key === 'Home'){ e.preventDefault(); smoothTarget = 0; clampTarget(); return; }
      if(e.key === 'End'){ e.preventDefault(); smoothTarget = maxScrollY(); clampTarget(); return; }
      if(isInHeroRange()) return; // let the hero video scrub natively, unsmoothed
      var step = keyStep(e.key);
      if(step === undefined) return;
      e.preventDefault();
      if(e.key === ' ' && e.shiftKey) step = -step;
      smoothTarget += step;
      clampTarget();
    }, {passive:false});

    // If the scroll position ever moves for a reason outside this system —
    // dragging the scrollbar thumb, the browser auto-scrolling a focused
    // element into view — resync instantly instead of fighting it or
    // snapping back on the next wheel/touch input.
    window.addEventListener('scroll', function(){
      var y = window.scrollY || docEl.scrollTop;
      if(Math.abs(y - lastAppliedY) > 1.5){
        smoothTarget = y;
        smoothCurrent = y;
      }
    }, {passive:true});

    window.addEventListener('resize', clampTarget);

    function smoothScrollRenderLoop(){
      smoothCurrent += (smoothTarget - smoothCurrent) * smoothEase;
      if(Math.abs(smoothTarget - smoothCurrent) < 0.05){
        smoothCurrent = smoothTarget;
      }
      var y = Math.round(smoothCurrent);
      if(y !== lastAppliedY){
        lastAppliedY = y;
        window.scrollTo(0, y);
      }
      requestAnimationFrame(smoothScrollRenderLoop);
    }
    requestAnimationFrame(smoothScrollRenderLoop);

    // In-page anchor links (nav "Projects" / "Work" / "Contact", etc.) jump
    // through the same eased system rather than the browser's instant hash
    // navigation, so every section-to-section jump on the site shares the
    // exact same slow/smooth/settle feel as scrolling itself.
    document.addEventListener('click', function(e){
      var a = e.target.closest ? e.target.closest('a[href^="#"]') : null;
      if(!a) return;
      var id = a.getAttribute('href').slice(1);
      if(!id) return; // bare "#" links (e.g. the logo) already handle themselves
      var el = document.getElementById(id);
      if(!el) return;
      e.preventDefault();
      window.__smoothScrollToEl(id);
    });
  })();
})();
</script>
